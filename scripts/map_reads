#!/usr/bin/env python3
"""map_reads: map reads to a genome, best alignment per read within k edits (forward strand only), with CIGAR.

  scripts/map_reads GENOME READS -k K [--format tsv|sam] [-o OUT]

GENOME  FASTA (first record is used) or a plain sequence file.
READS   FASTA, FASTQ, or one read per line.
Exact: the filter finds every end position with distance <= k (cross-checked against Sellers), then the best alignment
(minimum edit distance, ties: leftmost end) is traced back.  CIGAR uses SAM operators with the extended = / X:
  =  match   X  mismatch   I  extra read base   D  extra reference base.
TSV columns: read, length, status, distance, start (0-based), end (exclusive), strand, cigar, best_ends(number of end positions within k).
Unmapped reads (no alignment within k) get status "unmapped" and "*" fields.  Reverse-complement reads are NOT mapped.
"""
import argparse
import os
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BIN = os.path.join(ROOT, "approx")


def read_genome(path):
    name, seq = None, []
    for line in open(path):
        line = line.strip()
        if line.startswith(">"):
            if name is not None:
                break  # first record only
            name = line[1:].split()[0]
        elif line:
            seq.append(line.upper())
    return name or os.path.basename(path), "".join(seq)


def read_reads(path):
    lines = [l.rstrip("\n") for l in open(path) if l.strip()]
    reads = []
    if lines and lines[0].startswith("@"):                      # FASTQ
        for i in range(0, len(lines) - 3, 4):
            reads.append((lines[i][1:].split()[0], lines[i + 1].strip().upper()))
    elif lines and lines[0].startswith(">"):                    # FASTA
        name, seq = None, []
        for l in lines:
            if l.startswith(">"):
                if name is not None:
                    reads.append((name, "".join(seq).upper()))
                name, seq = l[1:].split()[0], []
            else:
                seq.append(l.strip())
        if name is not None:
            reads.append((name, "".join(seq).upper()))
    else:                                                       # one per line
        reads = [(f"read{i + 1}", l.strip().upper()) for i, l in enumerate(lines)]
    return reads


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("genome"); ap.add_argument("reads")
    ap.add_argument("-k", type=int, required=True, help="maximum edit distance")
    ap.add_argument("--format", choices=["tsv", "sam"], default="tsv")
    ap.add_argument("-o", "--out", default="-")
    a = ap.parse_args()
    if not os.path.exists(BIN):
        sys.exit(f"{BIN} not found: build with `make test` or g++ -O3 -std=c++17 -o approx src/approx.cpp")
    gname, genome = read_genome(a.genome)
    reads = read_reads(a.reads)
    with tempfile.TemporaryDirectory() as d:
        gp, rp = os.path.join(d, "g.txt"), os.path.join(d, "r.txt")
        open(gp, "w").write(genome + "\n")
        open(rp, "w").write("\n".join(r for _, r in reads) + "\n")
        out = subprocess.run([BIN, "map", gp, rp, str(a.k)], capture_output=True, text=True, check=True).stdout
    aln = {}
    for line in out.splitlines():
        if line.startswith("A "):
            t = line.split()
            aln[int(t[1])] = t[2:]
    o = sys.stdout if a.out == "-" else open(a.out, "w")
    if a.format == "tsv":
        o.write("read\tlength\tstatus\tdistance\tstart\tend\tstrand\tcigar\tbest_ends\n")
    else:
        o.write("@HD\tVN:1.6\tSO:unsorted\n" + f"@SQ\tSN:{gname}\tLN:{len(genome)}\n" + "@PG\tID:map_reads\tPN:map_reads\n")
    for i, (name, seq) in enumerate(reads):
        t = aln.get(i, ["*"] * 5 + ["0"])
        mapped = t[0] != "*"
        if a.format == "tsv":
            o.write("\t".join([name, str(len(seq)), "mapped" if mapped else "unmapped", t[0], t[1], t[2], "+" if mapped else "*", t[3], t[4]]) + "\n")
        elif mapped:
            o.write("\t".join([name, "0", gname, str(int(t[1]) + 1), "255", t[3], "*", "0", "0", seq, "*", f"NM:i:{t[0]}"]) + "\n")
        else:
            o.write("\t".join([name, "4", "*", "0", "0", "*", "*", "0", "0", seq, "*"]) + "\n")
    if o is not sys.stdout:
        o.close()


if __name__ == "__main__":
    main()
